# Copy to `.env` and fill in. `.env` is gitignored.

# --- StatsBomb ---
# The open data is free and needs NO credentials. Leave these blank unless you
# have a paid StatsBomb account and want statsbombpy to hit the private API.
SB_USERNAME=
SB_PASSWORD=

# Local clone of https://github.com/statsbomb/open-data (used as the data root).
STATSBOMB_DATA_DIR=data/raw/open-data

# --- Experiment logging (optional) ---
# Only needed if you install the `logging` extra and want Weights & Biases.
WANDB_API_KEY=
WANDB_PROJECT=football-state-of-play
WANDB_ENTITY=
