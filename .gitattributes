# Normalise line endings: text files stored as LF in the repo.
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.cfg   text eol=lf
*.ipynb text eol=lf
Makefile text eol=lf

# Binary assets (never normalise)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.parquet binary
*.npy   binary
*.npz   binary
*.pt    binary
*.pth   binary
